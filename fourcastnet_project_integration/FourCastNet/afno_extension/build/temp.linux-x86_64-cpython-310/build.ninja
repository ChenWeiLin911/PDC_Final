ninja_required_version = 1.3
cxx = /work/HPC_SYS/devtoolset/devtoolset-10/root/usr/bin/g++
nvcc = /work/HPC_SYS/twnia2/pkg-rocky8/nvidia/cuda/cuda-12.8/bin/nvcc

cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/r14922147/miniconda3/envs/PDC/include -fPIC -O2 -isystem /home/r14922147/miniconda3/envs/PDC/include -fPIC -I/home/r14922147/miniconda3/envs/PDC/lib/python3.10/site-packages/torch/include -I/home/r14922147/miniconda3/envs/PDC/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/r14922147/miniconda3/envs/PDC/lib/python3.10/site-packages/torch/include/TH -I/home/r14922147/miniconda3/envs/PDC/lib/python3.10/site-packages/torch/include/THC -I/work/HPC_SYS/twnia2/pkg-rocky8/nvidia/cuda/cuda-12.8/include -I/home/r14922147/miniconda3/envs/PDC/include/python3.10 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=afno_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/home/r14922147/miniconda3/envs/PDC/lib/python3.10/site-packages/torch/include -I/home/r14922147/miniconda3/envs/PDC/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/r14922147/miniconda3/envs/PDC/lib/python3.10/site-packages/torch/include/TH -I/home/r14922147/miniconda3/envs/PDC/lib/python3.10/site-packages/torch/include/THC -I/work/HPC_SYS/twnia2/pkg-rocky8/nvidia/cuda/cuda-12.8/include -I/home/r14922147/miniconda3/envs/PDC/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=afno_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_70,code=sm_70 -ccbin /work/HPC_SYS/devtoolset/devtoolset-10/root/usr/bin/gcc -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





